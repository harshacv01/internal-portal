# Postgres connection string. Any Postgres works; this project was developed
# against Neon, whose serverless driver it uses.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signing key for the session cookie. Generate one with:
#   openssl rand -base64 32
# Must be at least 32 characters. Rotating it invalidates every active session.
SESSION_SECRET="replace-me-with-at-least-32-random-characters"
